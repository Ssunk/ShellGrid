{
  "name": "shellgrid",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "description": "Windows 多终端工作区",
  "author": "ShellGrid contributors",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "node scripts/build.mjs",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "check": "npm run check:web && npm run check:electron",
    "check:web": "svelte-check --tsconfig ./tsconfig.json",
    "check:electron": "tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run && vitest run --config vitest.electron.config.ts",
    "test:watch": "vitest",
    "test:windows": "node scripts/test-windows.mjs",
    "test:installers": "node scripts/build-upgrade-test.mjs && pwsh -NoLogo -NoProfile -File scripts/verify-installers.ps1",
    "bench:windows": "node scripts/bench-windows.mjs",
    "dist:win": "npm run build && electron-builder --win nsis msi --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.12.0-beta.292",
    "@xterm/addon-search": "0.17.0-beta.292",
    "@xterm/addon-unicode11": "0.10.0-beta.292",
    "@xterm/addon-web-links": "0.13.0-beta.292",
    "@xterm/addon-webgl": "0.20.0-beta.291",
    "@xterm/xterm": "6.1.0-beta.292",
    "lucide-svelte": "^0.468.0",
    "node-pty": "1.2.0-beta.15",
    "svelte": "^5.56.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/svelte": "^5.2.10",
    "@types/node": "^24.0.0",
    "@xterm/headless": "6.1.0-beta.292",
    "electron": "42.8.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false,
    "esbuild": true,
    "node-pty": true
  }
}
